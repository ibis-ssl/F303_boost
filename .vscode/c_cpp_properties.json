{
    "env": {
        "stm32Compiler": "C:/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc.exe"
    },
    "configurations": [
        {
            "name": "STM32F303 Debug",
            "compilerPath": "${stm32Compiler}",
            "compilerArgs": ["-mcpu=cortex-m4", "-mthumb", "-mfpu=fpv4-sp-d16", "-mfloat-abi=hard", "--specs=nano.specs"],
            "intelliSenseMode": "windows-gcc-arm",
            "cStandard": "gnu11",
            "includePath": [
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/Drivers/STM32F3xx_HAL_Driver/Inc",
                "${workspaceFolder}/Drivers/STM32F3xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F3xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Include"
            ],
            "defines": ["DEBUG", "USE_HAL_DRIVER", "STM32F303xC"],
            "browse": {
                "path": ["${workspaceFolder}/Core", "${workspaceFolder}/Drivers"],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "STM32F303 Bootloader",
            "compilerPath": "${stm32Compiler}",
            "compilerArgs": ["-mcpu=cortex-m4", "-mthumb", "-mfpu=fpv4-sp-d16", "-mfloat-abi=hard", "--specs=nano.specs"],
            "intelliSenseMode": "windows-gcc-arm",
            "cStandard": "gnu11",
            "includePath": [
                "${workspaceFolder}/Bootloader/Inc",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F3xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Include"
            ],
            "defines": ["STM32F303xC"],
            "browse": {
                "path": [
                    "${workspaceFolder}/Bootloader/Inc",
                    "${workspaceFolder}/Bootloader/Src",
                    "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F3xx/Include",
                    "${workspaceFolder}/Drivers/CMSIS/Include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4,
    "enableConfigurationSquiggles": true
}
